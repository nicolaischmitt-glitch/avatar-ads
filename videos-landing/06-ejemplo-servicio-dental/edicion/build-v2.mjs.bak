// Anuncio 06 · ejemplo de servicio (clínica dental). Construye public/index.html.
// Misma mecánica que la plantilla del formato D (transcript.json + base-cortes.json + CONFIG), pero con la edición de un anuncio de clínica:
// blanco + turquesa, subtítulos por frase en píldora blanca, acercamientos lentos, transiciones suaves, rótulo de la doctora,
// tarjeta de planificación digital, botón "Agendar valoración" y cierre con la marca. Storyboard aprobado: ../storyboard/storyboard.png
// Uso: node build.mjs → hyperframes lint public → hyperframes render public -o ../final/… --fps 24
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const here = path.dirname(fileURLToPath(import.meta.url));
const words = JSON.parse(fs.readFileSync(path.join(here, "transcript.json"), "utf8"));
const segs = JSON.parse(fs.readFileSync(path.join(here, "base-cortes.json"), "utf8"));
const FPS = 24;
const HOLD = 0.7;                                       // cierre congelado al final (input-video.mp4 ya lo trae)
const DUR = Math.round((segs.at(-1).end + HOLD) * FPS) / FPS;

const q = (t) => Math.round(t * FPS) / FPS;
const f3 = (n) => +n.toFixed(3);
const cut = (t) => Math.floor(t * 1000) / 1000;
const ZE = 0.002;
const norm = (s) => s.toLowerCase().replace(/[¿?¡!.,]/g, "");
const at = (txt, from = 0) => {
  const w = words.find((x) => x.start >= from - 0.05 && norm(x.text) === norm(txt));
  if (!w) throw new Error(`No encuentro la palabra "${txt}" desde ${from}`);
  return w;
};
const S = (i) => segs[i].start;

// ───────────────────────── CONFIG ─────────────────────────
const ID = "anuncio-06";
// Segmentos (v2, pausas recortadas): 0 ¿Te da pena… fotos? · 1 Lo veo · 2 todos los días · 3 en la clínica · 4 Con el diseño de sonrisa · 5 planificamos… digital
//   6 y antes de empezar · 7 ya ves… quedar · 8 Agenda tu primera valoración · 9 en el botón de abajo · 10 y te mostramos… sonrisa · 11 Sin compromiso
// Cada elemento tiene un propósito: nada de títulos arriba que repitan el subtítulo (decisión del usuario, 23 oct 2026).
// Frases del subtítulo (en orden) y la palabra clave de cada una (en turquesa).
const PHRASES = [
  ["¿Te da pena sonreír", "sonreír"], ["en las fotos?", "fotos"], ["Lo veo todos los días", "todos los días"], ["en la clínica.", "clínica"],
  ["Con el diseño de sonrisa", "diseño de sonrisa"], ["planificamos tu cambio en digital", "en digital"], ["y antes de empezar", "antes de empezar"],
  ["ya ves cómo vas a quedar", "cómo vas a quedar"], ["Agenda tu primera valoración", "primera valoración"], ["en el botón de abajo", "botón de abajo"],
  ["y te mostramos tu nueva sonrisa", "nueva sonrisa"], ["Sin compromiso.", "Sin compromiso"],
];
// Zoom por segmento [entrada, salida]: lento (clínica, no golpes). Cada corte visible cambia la escala ≥ 0,1.
const ZOOM = [[1.0, 1.05], [1.1, 1.1], [1.1, 1.1], [1.12, 1.15], [1.0, 1.05], [1.05, 1.05], [1.12, 1.15], [1.15, 1.15], [1.0, 1.04], [1.15, 1.18], [1.0, 1.05], [1.12, 1.15]];
const T = {
  fotos: at("fotos").start,
  consult: [S(1), S(3)],                                         // B-roll consultorio: "Lo veo todos los días" (tapa 2 cortes)
  lower: [S(3), S(4)],                                           // rótulo de la doctora: "en la clínica" (autoridad)
  design: [S(5), S(6)],                                          // tarjeta de planificación digital (explica el servicio)
  stepT: [at("planificamos").start, at("cambio").start, at("digital").start],
  smile: [S(7), S(8)],                                           // B-roll sonrisa: "ya ves cómo vas a quedar" (el resultado)
  btn: [S(9), S(10)], boton: at("botón", S(9)).start,            // botón: "en el botón de abajo"
  end: [S(11), DUR],                                              // marca + botón hasta el final
};
const MEDIA = { consult: 2.6, smile: 1.5 };                      // desde qué segundo de cada B-roll
// ────────────────────────────────────────────────────────────

// ── subtítulos por frase
const display = (s) => s;
let wi = 0, subsHtml = "", subsJs = "";
const blocks = PHRASES.map(([text]) => {
  const n = text.split(/\s+/).length;
  const ws = words.slice(wi, wi + n);
  ws.forEach((w, k) => { if (norm(w.text) !== norm(text.split(/\s+/)[k])) throw new Error(`Frase "${text}": la palabra ${k + 1} es "${w.text}"`); });
  wi += n;
  return ws;
});
if (wi !== words.length) throw new Error(`Las frases cubren ${wi} de ${words.length} palabras`);
blocks.forEach((ws, i) => {
  const [text, key] = PHRASES[i];
  const start = Math.max(0, q(ws[0].start - 0.06));
  const end = blocks[i + 1] ? q(blocks[i + 1][0].start - 0.06) : DUR;
  const html = display(text).replace(key, `<b>${key}</b>`);
  const dark = start >= T.design[0] - 0.1 && start < T.design[1] ? " dark" : "";   // sobre la tarjeta blanca: texto oscuro
  subsHtml += `      <div class="sub clip${dark}" id="sub-${i}" data-start="${f3(start)}" data-duration="${f3(end - start)}" data-track-index="3"><span>${html}</span></div>\n`;
  subsJs += `          tl.fromTo("#sub-${i} span", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.2, ease: "power2.out" }, ${f3(start)});\n`;
});

// ── zooms lentos + un empuje suave en "fotos"
let zoomJs = "";
segs.forEach((s, i) => {
  const [a, b] = ZOOM[i];
  zoomJs += `          tl.set(Z, { scale: ${a} }, ${f3(Math.max(0, s.start - ZE))});\n`;
  if (i === 0) {
    const tf = q(T.fotos);
    zoomJs += `          tl.to(Z, { scale: ${b}, duration: ${f3(tf - s.start)}, ease: "none" }, ${f3(s.start)});\n`;
    zoomJs += `          tl.to(Z, { scale: ${b + 0.06}, duration: ${f3(s.end - tf - 0.05)}, ease: "power2.out" }, ${f3(tf)});\n`;
  } else {
    const end = i === segs.length - 1 ? DUR : s.end;
    zoomJs += `          tl.to(Z, { scale: ${b}, duration: ${f3(end - s.start - 0.05)}, ease: "none" }, ${f3(s.start)});\n`;
  }
});

const clip = ([a, b], track) => `data-start="${cut(a)}" data-duration="${f3(cut(b) - cut(a))}" data-track-index="${track}"`;

// ── sonido: música suave + pocos efectos, muy por debajo de la voz
const sfx = [
  ["click-soft", T.fotos, 0.365, 0.45],
  ["whoosh-short", T.consult[0] - 0.1, 0.574, 0.1],
  ["pop", T.lower[0] + 0.05, 0.72, 0.16],
  ["whoosh-short", T.design[0] - 0.1, 0.574, 0.1],
  ...T.stepT.map((t) => ["click-soft", t, 0.365, 0.22]),
  ["whoosh-short", T.smile[0] - 0.1, 0.574, 0.1],
  ["chime", T.boton, 1, 0.16],
  ["pop", T.end[0] + 0.05, 0.72, 0.16],
];
const sfxHtml = sfx.map(([n, t, d, v], i) =>
  `      <audio id="sfx-${String(i + 1).padStart(2, "0")}-${n}" src="audio/${n}.mp3" data-start="${f3(q(t))}" data-duration="${f3(Math.min(d, DUR - q(t)))}" data-track-index="${11 + (i % 4)}" data-volume="${v}"></audio>`).join("\n");

// ── dientes del gráfico (arco superior)
const TW = [50, 58, 66, 80, 80, 66, 58, 50], TH = [78, 92, 106, 124, 124, 106, 92, 78], DY = [34, 18, 6, 0, 0, 6, 18, 34];
let tx = 400 - TW.reduce((a, b) => a + b + 8, 0) / 2;
const teeth = TW.map((w, i) => { const r = `<rect class="tooth" id="tooth-${i}" x="${tx.toFixed(0)}" y="${130 + DY[i]}" width="${w}" height="${TH[i]}" rx="${(w / 2.4).toFixed(0)}" fill="#fff" stroke="#0E7C86" stroke-width="5"/>`; tx += w + 8; return r; }).join("");

const ARROW = `<svg viewBox="0 0 24 24" fill="none" stroke="#0E7C86" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>`;
const BTN = (id) => `<div class="btnw"><div class="ring" id="${id}-ring"></div><div class="btn">Agendar valoración ${ARROW}</div></div>`;

const html = `<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <style>
      @font-face { font-family: "Jakarta"; src: url("fonts/PlusJakartaSans.woff2") format("woff2"); font-weight: 200 800; font-display: block; }
      :root { --teal: #0E7C86; --teal-2: #13A3A0; --mint: #DDF3F1; --ink: #0F2A33; --soft: #5B7480; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #fff; font-family: "Jakarta", sans-serif; color: var(--ink); }
      #stage { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: #fff; }
      #video-wrap { position: absolute; inset: 0; overflow: hidden; z-index: 1; }
      #zoom { position: absolute; inset: 0; transform-origin: 50% 33%; }
      #zoom video { width: 100%; height: 100%; object-fit: cover; }
      .g { position: absolute; z-index: 10; left: 0; top: 0; width: 1080px; height: 1920px; pointer-events: none; }
      .center { position: absolute; left: 0; right: 0; display: flex; justify-content: center; }
      /* subtítulo por frase (altura del pecho, fuera del 20 % inferior) */
      .sub { position: absolute; z-index: 20; left: 0; right: 0; top: 1330px; display: flex; justify-content: center; pointer-events: none; }
      /* sin caja: así no se confunde con el botón (la única píldora en pantalla) */
      .sub span { display: inline-block; color: #fff; font-weight: 800; font-size: 64px; line-height: 1.15; letter-spacing: -0.5px; text-align: center; max-width: 960px;
        text-shadow: 0 3px 4px rgba(6,30,36,.55), 0 6px 28px rgba(6,30,36,.65); }
      .sub b { color: #B9FFF4; font-weight: 800; }
      .sub.dark span { color: var(--ink); text-shadow: none; }
      .sub.dark b { color: var(--teal); }
      /* pastillas sobre la cabeza */
      .pill { display: inline-flex; align-items: center; gap: 18px; padding: 22px 40px; border-radius: 999px; background: var(--teal); color: #fff; font-weight: 800; font-size: 40px;
        letter-spacing: 2px; text-transform: uppercase; box-shadow: 0 12px 34px rgba(14,124,134,.35); white-space: nowrap; }
      .pill.light { background: rgba(255,255,255,.96); color: var(--teal); }
      .pill svg { width: 44px; height: 44px; }
      /* visor de cámara alrededor de la cara */
      .vf { position: absolute; left: 290px; top: 250px; width: 500px; height: 660px; }
      .vf i { position: absolute; width: 90px; height: 90px; border: 0 solid #fff; filter: drop-shadow(0 2px 8px rgba(0,0,0,.35)); }
      .vf i:nth-child(1) { left: 0; top: 0; border-left-width: 10px; border-top-width: 10px; border-top-left-radius: 26px; }
      .vf i:nth-child(2) { right: 0; top: 0; border-right-width: 10px; border-top-width: 10px; border-top-right-radius: 26px; }
      .vf i:nth-child(3) { left: 0; bottom: 0; border-left-width: 10px; border-bottom-width: 10px; border-bottom-left-radius: 26px; }
      .vf i:nth-child(4) { right: 0; bottom: 0; border-right-width: 10px; border-bottom-width: 10px; border-bottom-right-radius: 26px; }
      .flash { position: absolute; inset: 0; background: #fff; opacity: 0; }
      /* rótulo */
      .lower { position: absolute; left: 70px; top: 1110px; display: flex; align-items: stretch; border-radius: 26px; overflow: hidden; box-shadow: 0 14px 40px rgba(15,42,51,.25); }
      .lower .bar { width: 16px; background: var(--teal); }
      .lower .txt { background: rgba(255,255,255,.96); padding: 24px 40px 24px 30px; }
      .lower .n { font-weight: 800; font-size: 50px; color: var(--ink); }
      .lower .r { font-weight: 600; font-size: 32px; color: var(--teal); margin-top: 6px; }
      /* B-roll a pantalla completa */
      .bvid { position: absolute; z-index: 8; left: 0; top: 0; width: 1080px; height: 1920px; object-fit: cover; }
      /* tarjeta de planificación digital */
      .full { position: absolute; z-index: 8; inset: 0; overflow: hidden; }
      .full .bg { position: absolute; inset: -60px; width: calc(100% + 120px); height: calc(100% + 120px); object-fit: cover; filter: blur(26px) saturate(.9); }
      .full .veil { position: absolute; inset: 0; background: rgba(246,250,250,.72); }
      .design { position: absolute; left: 90px; right: 90px; top: 300px; background: #fff; border-radius: 48px; padding: 60px 56px; box-shadow: 0 30px 80px rgba(15,42,51,.18); }
      .design h3 { margin: 0; font-weight: 800; font-size: 54px; color: var(--ink); text-align: center; }
      .design h3 span { color: var(--teal); }
      .scan { position: relative; height: 420px; margin: 40px 0 46px; border-radius: 30px; background-color: var(--mint); overflow: hidden;
        background-image: linear-gradient(rgba(14,124,134,.10) 2px, transparent 2px), linear-gradient(90deg, rgba(14,124,134,.10) 2px, transparent 2px); background-size: 46px 46px; }
      .scan svg { position: absolute; inset: 0; width: 100%; height: 100%; }
      .scan .line { position: absolute; top: 0; bottom: 0; left: 0; width: 6px; background: var(--teal-2); box-shadow: 0 0 30px var(--teal-2); }
      .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
      .step { position: relative; border: 3px solid #CFE3E3; border-radius: 28px; padding: 28px 18px; text-align: center; overflow: hidden; }
      .step .on { position: absolute; inset: 0; background: var(--mint); border: 3px solid var(--teal); border-radius: 28px; opacity: 0; }
      .step .k, .step .t { position: relative; }
      .step .k { width: 64px; height: 64px; border-radius: 50%; background: var(--teal); color: #fff; font-weight: 800; font-size: 36px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
      .step .t { font-weight: 700; font-size: 34px; color: var(--ink); }
      /* botón y marca */
      .btnw { position: relative; display: inline-block; }
      .btn { position: relative; display: inline-flex; align-items: center; gap: 24px; background: #fff; color: var(--teal); font-weight: 800; font-size: 60px; padding: 36px 64px; border-radius: 999px;
        border: 5px solid var(--teal); box-shadow: 0 20px 60px rgba(6,30,36,.35); white-space: nowrap; }
      .btn svg { width: 58px; height: 58px; }
      .ring { position: absolute; inset: -5px; border-radius: 999px; border: 5px solid #fff; opacity: 0; }
      .brand { display: inline-flex; align-items: center; gap: 22px; background: rgba(255,255,255,.96); padding: 24px 44px; border-radius: 999px; box-shadow: 0 12px 34px rgba(15,42,51,.2); }
      .brand svg { width: 64px; height: 64px; }
      .brand b { font-weight: 800; font-size: 50px; color: var(--ink); }
      .brand b span { color: var(--teal); }
    </style>
  </head>
  <body>
    <div id="stage" data-composition-id="${ID}" data-start="0" data-duration="${f3(DUR)}" data-fps="${FPS}" data-width="1080" data-height="1920">
      <div id="video-wrap">
        <div id="zoom"><video id="bg-video" src="input-video.mp4" playsinline data-has-audio="true" data-start="0" data-duration="${f3(DUR)}" data-track-index="1"></video></div>
      </div>
      <audio id="bgm" src="audio/bgm.wav" data-start="0" data-duration="${f3(DUR)}" data-track-index="2" data-volume="1"></audio>

      <!-- 02 · visor de cámara en "fotos" -->
      <div class="g clip" id="foto" ${clip([T.fotos - 0.08, S(1)], 6)}>
        <div class="vf" id="vf"><i></i><i></i><i></i><i></i></div>
        <div class="flash" id="flash"></div>
      </div>

      <!-- 03 · B-roll consultorio -->
      <video class="bvid clip" id="consult" src="broll/consultorio.mp4" muted playsinline data-media-start="${MEDIA.consult}" ${clip(T.consult, 9)}></video>

      <!-- 04 · rótulo de la doctora -->
      <div class="g clip" id="lower" ${clip(T.lower, 6)}>
        <div class="lower" id="lower-box"><div class="bar"></div><div class="txt"><div class="n">Dra. Valeria Ortiz</div><div class="r">Odontóloga · Diseño de sonrisa</div></div></div>
      </div>

      <!-- 06 · planificación digital -->
      <div class="full clip" id="design" ${clip(T.design, 8)}>
        <img class="bg" src="broll/consultorio-bg.jpg" alt=""><div class="veil"></div>
        <div class="design" id="design-card">
          <h3>Planificación <span>digital</span></h3>
          <div class="scan">
            <svg viewBox="0 0 800 420" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path id="arch" d="M90 150 Q400 330 710 150" stroke="#0E7C86" stroke-width="4" stroke-dasharray="10 12" opacity=".6"/>
              ${teeth}
              <path id="smile" d="M150 300 Q400 380 650 300" stroke="#0E7C86" stroke-width="5" stroke-dasharray="560" stroke-dashoffset="560"/>
            </svg>
            <div class="line" id="scanline"></div>
          </div>
          <div class="steps">
            <div class="step"><div class="on" id="step-0"></div><div class="k">1</div><div class="t">Escaneo</div></div>
            <div class="step"><div class="on" id="step-1"></div><div class="k">2</div><div class="t">Diseño</div></div>
            <div class="step"><div class="on" id="step-2"></div><div class="k">3</div><div class="t">Vista previa</div></div>
          </div>
        </div>
      </div>

      <!-- 08 · B-roll sonrisa -->
      <video class="bvid clip" id="smile-v" src="broll/sonrisa.mp4" muted playsinline data-media-start="${MEDIA.smile}" ${clip(T.smile, 9)}></video>
      <!-- 10 · botón -->
      <div class="g clip" id="btn1" ${clip(T.btn, 7)}>
        <div class="center" style="top:1110px"><div id="btn1-b">${BTN("btn1")}</div></div>
      </div>

      <!-- 12 · cierre: marca + botón -->
      <div class="g clip" id="end" ${clip(T.end, 7)}>
        <div class="center" style="top:120px"><div class="brand" id="end-brand">
          <svg viewBox="0 0 24 24" fill="none" stroke="#0E7C86" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3c-2.5 0-4 2-4 4.5 0 3 1.5 4.5 2 7 .5 2.5 1 6.5 2.5 6.5S9.5 17 12 17s3 4 4.5 4 2-4 2.5-6.5c.5-2.5 2-4 2-7C21 5 19.5 3 17 3c-2 0-3 1-5 1S9 3 7 3z"/></svg>
          <b>Clínica Dental <span>Alba</span></b></div></div>
        <div class="center" style="top:1110px"><div id="end-btn">${BTN("end")}</div></div>
      </div>

${subsHtml}
${sfxHtml}

      <script src="vendor/gsap.min.js"></script>
      <script>
        (function () {
          const tl = window.gsap.timeline({ paused: true });
          const Z = "#zoom";
${zoomJs}
${subsJs}
          const rise = (sel, t, d = 0.4) => tl.fromTo(sel, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: d, ease: "power3.out" }, t);
          const soft = (sel, t) => tl.fromTo(sel, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(1.6)" }, t);
          const fadeIn = (sel, t, d = 0.25) => tl.fromTo(sel, { opacity: 0 }, { opacity: 1, duration: d, ease: "power1.out" }, t);

          // 02 · visor + destello
          tl.fromTo("#vf", { opacity: 0, scale: 1.12 }, { opacity: 1, scale: 1, duration: 0.25, ease: "power3.out" }, ${f3(T.fotos - 0.08)});
          tl.fromTo("#flash", { opacity: 0 }, { opacity: 0.55, duration: 0.06 }, ${f3(q(T.fotos))});
          tl.to("#flash", { opacity: 0, duration: 0.3, ease: "power2.out" }, ${f3(q(T.fotos) + 0.06)});
          // 03 · consultorio (entra con fundido corto, empuje lento)
          fadeIn("#consult", ${cut(T.consult[0])}, 0.18);
          tl.fromTo("#consult", { scale: 1.04 }, { scale: 1.1, duration: ${f3(T.consult[1] - T.consult[0])}, ease: "none" }, ${cut(T.consult[0])});
          // 04 · rótulo
          tl.fromTo("#lower-box", { opacity: 0, x: -60 }, { opacity: 1, x: 0, duration: 0.45, ease: "power3.out" }, ${f3(T.lower[0] + 0.05)});
          // 06 · planificación digital
          fadeIn("#design", ${cut(T.design[0])}, 0.2);
          rise("#design-card", ${f3(T.design[0] + 0.05)}, 0.45);
          for (let i = 0; i < 8; i++) tl.fromTo("#tooth-" + i, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.22, ease: "back.out(2)" }, ${f3(T.design[0] + 0.3)} + i * 0.05);
          tl.fromTo("#scanline", { x: 40 }, { x: 740, duration: 1.6, ease: "sine.inOut" }, ${f3(T.design[0] + 0.3)});
          tl.to("#smile", { strokeDashoffset: 0, duration: 0.9, ease: "power2.inOut" }, ${f3(T.stepT[1])});
          ${JSON.stringify(T.stepT.map(q))}.forEach((t, i) => tl.to("#step-" + i, { opacity: 1, duration: 0.25 }, t));
          // 08 · sonrisa
          fadeIn("#smile-v", ${cut(T.smile[0])}, 0.18);
          // 10 · botón (entra y rebota en "botón")
          soft("#btn1-b", ${f3(T.btn[0] + 0.03)});
          tl.to("#btn1-b", { y: 12, duration: 0.22, yoyo: true, repeat: 3, ease: "sine.inOut" }, ${f3(q(T.boton))});
          const pulse = (id, t, n) => { for (let k = 0; k < n; k++) tl.fromTo(id, { opacity: 0.9, scale: 1 }, { opacity: 0, scale: 1.18, duration: 0.7, ease: "power2.out" }, t + k * 0.75); };
          pulse("#btn1-ring", ${f3(T.btn[0] + 0.3)}, 1);
          // 12 · cierre
          rise("#end-brand", ${f3(T.end[0] + 0.03)});
          soft("#end-btn", ${f3(T.end[0] + 0.08)});
          pulse("#end-ring", ${f3(T.end[0] + 0.45)}, 2);

          window.__timelines = window.__timelines || {};
          window.__timelines["${ID}"] = tl;
        })();
      </script>
    </div>
  </body>
</html>
`;
fs.writeFileSync(path.join(here, "public", "index.html"), html);
const off = [T.consult, T.design, T.smile].reduce((s, [a, b]) => s + (b - a), 0);
